{
  "name": "wikhippo",
  "productName": "Wikhippo",
  "version": "1.0.0",
  "description": "Révise tes cours : fiches de synthèse, cartes, quiz. Par @hippo.reporter",
  "author": "@hippo.reporter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.hippo.wikhippo",
    "productName": "Wikhippo",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false
  }
}
